# Salin file ini jadi .env lalu sesuaikan. Semua opsional kecuali disebut wajib.

# Folder tempat database dan semua file upload disimpan (arahkan ke folder di NAS).
DATA_DIR=./data

# Password awal untuk akun bawaan. Hanya dipakai saat database pertama kali dibuat.
INITIAL_PASSWORD=trilogy-2026

# Alamat publik aplikasi. Wajib diisi kalau dibuka lewat subdomain / reverse proxy.
APP_URL=https://creative.domainkamu.com
ALLOWED_ORIGINS=creative.domainkamu.com

# Kontak pengirim push notif (format mailto: atau https://). Disarankan diisi email asli.
VAPID_SUBJECT=mailto:admin@domainkamu.com

# Batas ukuran satu file upload, dalam MB.
MAX_UPLOAD_MB=5120

# Zona waktu untuk jam kerja dan SLA.
TZ=Asia/Jakarta
